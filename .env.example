# Copy to .env (git-ignored) and fill in only what you use. Heartcut reads keys from
# environment variables only; they are never written to configs, caches or results.

# Hosted teachers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Where downloads and the teacher-completion cache live (default: ./.cache/heartcut)
# HEARTCUT_CACHE_DIR=.cache/heartcut

# Serving (`heartcut serve` / Docker)
# HEARTCUT_MODEL_DIR=/models/student
# HEARTCUT_FALLBACK_THRESHOLD=0.5           # route low-confidence requests to the teacher
# HEARTCUT_TEACHER_CONFIG=configs/teachers/claude-haiku-5-5.yaml

# Hugging Face Hub: publishing cached teacher labels, and fetching gated or private
# datasets in Heartcut Studio (public datasets need no token)
# HF_TOKEN=
