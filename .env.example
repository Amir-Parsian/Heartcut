# Copy to .env (git-ignored) and fill in only what you use. DistillKit reads keys from
# environment variables only; they are never written to configs, caches or results.

# Hosted teachers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Where downloads and the teacher-completion cache live (default: ./.cache/distillkit)
# DISTILLKIT_CACHE_DIR=.cache/distillkit

# Serving (`distillkit serve` / Docker)
# DISTILLKIT_MODEL_DIR=/models/student
# DISTILLKIT_FALLBACK_THRESHOLD=0.5           # route low-confidence requests to the teacher
# DISTILLKIT_TEACHER_CONFIG=configs/teachers/claude-haiku-5-5.yaml

# Publishing cached teacher labels to the Hugging Face Hub
# HF_TOKEN=
